FROM node:22-bookworm-slim AS ui
WORKDIR /src
COPY package*.json ./
RUN npm ci
COPY desktop ./desktop
COPY tsconfig.json vite.config.ts ./
RUN npm run build

FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 alshitasks && useradd -u 10001 -g 10001 -m alshitasks
WORKDIR /app
COPY service/server-requirements.txt service/log-requirements.txt /app/service/
RUN pip install --no-cache-dir -r service/server-requirements.txt
COPY service /app/service
COPY contracts /app/contracts
COPY package.json /app/package.json
COPY --from=ui /src/dist /app/dist
RUN mkdir /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 43120
ENTRYPOINT ["python", "/app/service/alshitasks-cli.py"]
CMD ["server", "--data-dir", "/data", "--key-file", "/run/secrets/master.key", "--host", "0.0.0.0", "--port", "43120", "--base-url", "http://127.0.0.1:43120"]
