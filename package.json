{
  "name": "alshitasks",
  "productName": "Alshival.Ai",
  "desktopName": "alshitasks.desktop",
  "version": "0.1.47",
  "description": "Local-first Windows and Linux task boards, resources and monitoring",
  "license": "Apache-2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "python3 -m unittest discover -s tests -v",
    "validate": "npm run build && npm test",
    "start": "electron .",
    "package:deb": "npm run build && python3 scripts/package-deb.py",
    "package:windows": "npm run build && python scripts/package-windows.py"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.8.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
